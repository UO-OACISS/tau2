##  Indiana University  University of Oregon  University of Rennes   ##
#######################################################################

TAUROOTDIR	= ../..

include $(TAUROOTDIR)/include/Makefile

CXX		= $(TAU_CXX)

CC		= $(TAU_CC)

TAUINC	        = -I$(TAUROOT)/include -I$(TAUROOT)/include/Profile

CFLAGS          = $(TAU_MPI_COMPILE_INCLUDE) $(TAU_INCLUDE) $(TAUINC) $(TAU_DEFS) $(USER_OPT) $(TAU_INTERNAL_FLAGS)

CXXFLAGS	= $(CFLAGS) $(TAU_STDCXX11_FLAG)

RM		= /bin/rm -f

AR		= $(TAU_AR)

ARFLAGS		= rcv

INSTALLDEST	= $(TAU_PREFIX_INSTALL_DIR)/$(CONFIG_ARCH)/lib

TAU_TARGET		= libTauMpi$(TAU_CONFIG)$(LSX)

##############################################



all : 		$(TAU_TARGET)

install:	$(INSTALLDEST)/$(TAU_TARGET)

$(TAU_TARGET) : TauMpi.o TauRequest.o TauTranslateRank.o ClockSync.o TauProfileMerge.o TauMetaDataMerge.o $(FWRAPPER) $(MPI2EXTENSIONS) $(MPI3EXTENSIONS) $(MPI4EXTENSIONS) $(MPI_FORTRAN_INIT) $(TAU_MPIT)
	$(AR) $(ARFLAGS) $(TAU_TARGET) TauMpi.o TauRequest.o TauTranslateRank.o ClockSync.o TauProfileMerge.o TauMetaDataMerge.o $(FWRAPPER) $(MPI3EXTENSIONS) $(MPI4EXTENSIONS) $(MPI_FORTRAN_INIT) $(TAU_MPIT)
	$(TAU_RANLIB) $(TAU_TARGET)

TauMpi.o : TauMpi.c
	$(CC) $(CFLAGS) $(TAU_MPI_INCLUDE) -c TauMpi.c

TauMpiT.o : TauMpiT.c
	$(CC) $(CFLAGS) -c TauMpiT.c

TauRequest.o : TauRequest.cpp
	$(CXX) $(CFLAGS) $(TAU_MPI_INCLUDE)  $(TAU_STDCXX11_FLAG) -c TauRequest.cpp

TauTranslateRank.o : TauTranslateRank.cpp
	$(CXX) $(CFLAGS) $(TAU_MPI_INCLUDE)  $(TAU_STDCXX11_FLAG) -c TauTranslateRank.cpp

TauFMpi.o : TauFMpi.c
	$(CC) $(TAU_MPI_INCLUDE)  $(CFLAGS) -c TauFMpi.c

TauFInit.o : TauFInit.f
	$(TAU_F90) $(TAU_INTERNAL_FLAGS) $(TAU_MPI_INC) $(FFLAGS) $(PROFILEOPT10) -c TauFInit.f

TauMpiExtensions.o : 	TauMpiExtensions.c
	$(CC) $(TAU_MPI_INCLUDE)  $(CFLAGS) -c TauMpiExtensions.c

ClockSync.o : ClockSync.c
	$(CC) $(CFLAGS) $(TAU_MPI_INCLUDE)  -c ClockSync.c

TauProfileMerge.o : TauProfileMerge.cpp
	$(CXX) $(CFLAGS) $(TAU_MPI_INCLUDE)  $(TAU_STDCXX11_FLAG) -c TauProfileMerge.cpp

TauMetaDataMerge.o : TauMetaDataMerge.cpp
	$(CXX) $(CFLAGS) $(TAU_MPI_INCLUDE)  $(TAU_STDCXX11_FLAG) -c TauMetaDataMerge.cpp

# Copies of TAU_MPI_SHARED_OBJS for the macOS shared library
# The MPI wrappers are renamed so that libTAU can interpose
TAU_MPI_INTERPOSE_OBJS = $(TAU_MPI_SHARED_OBJS:.o=.ip.o) TauMpiInterpose.o

interpose: $(TAU_MPI_INTERPOSE_OBJS)

TauMpiInterpose.h: $(TAU_MPI_SHARED_OBJS) tau_mpi_interpose_gen.sh
	sh tau_mpi_interpose_gen.sh header $(TAU_MPI_SHARED_OBJS) > $@

TauMpiInterpose.c: $(TAU_MPI_SHARED_OBJS) tau_mpi_interpose_gen.sh
	sh tau_mpi_interpose_gen.sh source $(TAU_MPI_SHARED_OBJS) > $@

TauMpiInterpose.o: TauMpiInterpose.c
	$(CC) $(CFLAGS) -c TauMpiInterpose.c

%.ip.o: %.c TauMpiInterpose.h
	$(CC) $(CFLAGS) $(TAU_MPI_INCLUDE) -include TauMpiInterpose.h -c $< -o $@

%.ip.o: %.cpp TauMpiInterpose.h
	$(CXX) $(CFLAGS) $(TAU_MPI_INCLUDE) $(TAU_STDCXX11_FLAG) -include TauMpiInterpose.h -c $< -o $@

$(INSTALLDEST)/$(TAU_TARGET): $(TAU_TARGET)
		@echo Installing $? in $(INSTALLDEST)
		if [ -d $(INSTALLDEST) ] ; then true; \
                   else mkdir $(INSTALLDEST) ;fi
		$(TAU_INSTALL) $? $(INSTALLDEST)
clean:
	$(RM) core TauMpi.o TauRequest.o TauTranslateRank.o $(TAU_TARGET) *.ip.o TauMpiInterpose.[cho]
##############################################
