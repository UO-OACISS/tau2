include perfstubs.mk

# The perfstubs library should be installed in the shared library directory
# for the particular tags used for the current config. This is needed so 
# that configs for different Python interpreter versions can be installed
# at the same time.
BUILDDIR=build$(TAUOPTIONS)
INSTALLDIR=$(PREFIX)/$(TAUARCH)
PYMODULEDIR=$(INSTALLDIR)/lib/shared$(TAUOPTIONS)

$(BUILDDIR)/CMakeCache.txt:
	cmake -B $(BUILDDIR) -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_C_COMPILER=$(CC) -DCMAKE_CXX_COMPILER=$(CXX) -DCMAKE_INSTALL_PREFIX=$(INSTALLDIR) -DCMAKE_INSTALL_LIBDIR=lib $(TAUPYTHON) $(TAUCFLAGS) $(TAUCXXFLAGS)

all : $(BUILDDIR)/CMakeCache.txt
	$(MAKE) -C $(BUILDDIR) all

# tau_python searches bindings$(TAUOPTIONS). The pytau install normally
# creates that link, but pstubs-only configurations don't install pytau.
install: all
	$(MAKE) -C $(BUILDDIR) install
	mkdir -p $(PYMODULEDIR)
	mv -f $(INSTALLDIR)/lib/perfstubs.so $(PYMODULEDIR)/perfstubs.so
	cd $(INSTALLDIR)/lib && ln -sfn shared$(TAUOPTIONS) bindings$(TAUOPTIONS)

clean:
	rm -rf $(BUILDDIR)
